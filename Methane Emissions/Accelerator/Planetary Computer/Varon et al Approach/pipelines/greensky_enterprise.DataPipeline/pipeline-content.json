                "type": "Expression"
              },
              "type": "string"
            },
            "end_date": {
              "value": {
                "value": "@if(empty(pipeline().parameters.pipeline_date), '', formatDateTime(addDays(pipeline().parameters.pipeline_date, 1), 'yyyy-MM-dd'))",
                "type": "Expression"
