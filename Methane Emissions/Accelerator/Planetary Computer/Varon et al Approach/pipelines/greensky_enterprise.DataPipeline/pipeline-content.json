{
  "properties": {
    "description": "Enterprise / SCADA: 02a -> 03a -> 02b -> (02c | 02d); 02a -> 02e; (02b, 02d, 02e) -> 03c -> 03b -> 03d -> 03e. The estate's clock is TOPOLOGY_AS_OF, not the calendar: with pipeline_date empty every notebook derives its own half-open window (TOPOLOGY_AS_OF, its watermark, or its sources' span). A pipeline_date P overrides it: end_date P+1, start_date P for incremental and empty for backfill. Needs the 01 topology dims and greensky_detection's gold_plume_catalog / gold_multi_gas_signatures.",
    "activities": [
      {
        "type": "IfCondition",
        "name": "validate_parameters",
        "description": "Fails the run before any notebook starts if run_mode is not exactly 'incremental' or 'backfill', or pipeline_date is not empty / yyyy-MM-dd. The notebooks treat any other run_mode as backfill.",
        "typeProperties": {
          "expression": {
            "value": "@and(or(equals(pipeline().parameters.run_mode, 'incremental'), equals(pipeline().parameters.run_mode, 'backfill')), or(empty(pipeline().parameters.pipeline_date), equals(length(pipeline().parameters.pipeline_date), 10)))",
            "type": "Expression"
          },
          "ifTrueActivities": [],
          "ifFalseActivities": [
            {
              "type": "Fail",
              "name": "fail_invalid_parameters",
              "typeProperties": {
                "message": {
                  "value": "@concat('greensky_enterprise: invalid parameters run_mode=[', pipeline().parameters.run_mode, '] pipeline_date=[', pipeline().parameters.pipeline_date, ']. run_mode must be incremental or backfill; pipeline_date must be empty or yyyy-MM-dd.')",
                  "type": "Expression"
                },
                "errorCode": "INVALID_PARAMETERS"
              },
              "dependsOn": []
            }
          ]
        },
        "dependsOn": []
      },
      {
        "type": "TridentNotebook",
        "name": "02a_build_asset_state",
