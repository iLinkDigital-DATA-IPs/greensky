{
  "properties": {
    "description": "Detection: ingest (4 in parallel) -> 03 join -> 04 -> 04b -> 05 -> 06. pipeline_date P is the day processed (UTC trigger date when empty); windows are half-open, incremental [P, P+1), backfill [DETECTION_HISTORY_START, P+1).",
    "activities": [
      {
        "type": "IfCondition",
        "name": "validate_parameters",
        "description": "Fails the run before any notebook starts if run_mode is not exactly 'incremental' or 'backfill', or pipeline_date is not empty / yyyy-MM-dd. The notebooks treat any other run_mode as backfill.",
        "typeProperties": {
          "expression": {
            "value": "@and(or(equals(pipeline().parameters.run_mode, 'incremental'), equals(pipeline().parameters.run_mode, 'backfill')), or(empty(pipeline().parameters.pipeline_date), equals(length(pipeline().parameters.pipeline_date), 10)))",
            "type": "Expression"
          },
          "ifTrueActivities": [],
          "ifFalseActivities": [
            {
              "type": "Fail",
              "name": "fail_invalid_parameters",
              "typeProperties": {
                "message": {
                  "value": "@concat('greensky_detection: invalid parameters run_mode=[', pipeline().parameters.run_mode, '] pipeline_date=[', pipeline().parameters.pipeline_date, ']. run_mode must be incremental or backfill; pipeline_date must be empty or yyyy-MM-dd.')",
                  "type": "Expression"
                },
                "errorCode": "INVALID_PARAMETERS"
              },
              "dependsOn": []
            }
          ]
        },
        "dependsOn": []
      },
      {
